# GEMINI_API_KEY: Required for server-side Google Gemini API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Cloud Run, attach via Secret Manager (--set-secrets GEMINI_API_KEY=gemini-api-key:latest).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this service is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin bootstrap/override passcode.
# If unset, the first user can claim the Admin Console via the first-run setup UI.
ADMIN_PASSCODE=

# DATABASE_PATH: Optional path to the SQLite database file (defaults to ./data/glaxyes.db).
# On stateless Cloud Run containers without a volume mount, /tmp/glaxyes.db or a GCS/Filestore mount can be used.
DATABASE_PATH=
